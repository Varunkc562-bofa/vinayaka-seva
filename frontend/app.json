{
  "expo": {
    "name": "Vinayaka Seva",
    "slug": "frontend",
    "version": "1.0.0",
    "jsEngine": "jsc",
    "orientation": "portrait",
    "icon": "./assets/images/vinayaka-icon.png",
    "scheme": "vinayaka-seva",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ganasetu.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach photos to bills, announcements and the community gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/vinayaka-icon.png",
        "backgroundColor": "#f4a62a"
      },
      "package": "com.ganasetu.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos to bills, announcements and gallery"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91505524-a938-4113-9ccd-607f60e05b7d"
      }
    },
    "owner": "varunkc562s-team"
  }
}
